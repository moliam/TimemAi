#!/usr/bin/env expect
#
# Real PTY smoke for questions queued while an active turn is running. It uses a local fake
# OpenAI-compatible model server, so it does not need network or a real API key.

set timeout 60

set repo_root [file normalize [file join [file dirname [info script]] ".."]]
set binary [file join $repo_root "target" "release" "timem-native-rs"]
set model_server_script [file join $repo_root "scripts" "fake_openai_server.py"]
set memory_dir [file join "/private/tmp" "timem_tty_supplement_smoke_[pid]"]
set port 0

if {![file executable $binary]} {
    puts stderr "missing executable: $binary"
    puts stderr "run: cargo build -p timem_shell --release"
    exit 1
}

proc answer_cursor_queries {} {
    expect {
        -re "\033\\\[6n" {
            send "\033\[24;1R"
            exp_continue
        }
        -re "Thought / Action" {
            return
        }
        timeout {
            error "timeout waiting for thinking panel"
        }
        eof {
            error "unexpected EOF waiting for thinking panel"
        }
    }
}

proc wait_prompt {} {
    while {1} {
        expect {
            -re "\033\\\[6n" {
                send "\033\[24;1R"
                exp_continue
            }
            -re "❯❯" {
                return
            }
            timeout {
                error "timeout waiting for Timem prompt"
            }
            eof {
                error "unexpected EOF waiting for Timem prompt"
            }
        }
    }
}

proc wait_active_turn_cancelled {} {
    set output ""
    expect {
        -re "\033\\\[6n" {
            append output $expect_out(buffer)
            send "\033\[24;1R"
            if {[string first "已取消本轮" $output] >= 0} {
                return $output
            }
            exp_continue
        }
        -re "已取消本轮" {
            append output $expect_out(buffer)
            return $output
        }
        -re "NO_SUPPLEMENT|SUPPLEMENT_OK|模型调用失败" {
            append output $expect_out(buffer)
            error "active turn was not cancelled promptly; got model output: $output"
        }
        timeout {
            error "timeout waiting for active turn cancellation"
        }
        eof {
            error "unexpected EOF waiting for active turn cancellation"
        }
    }
}

spawn -noecho python3 -u $model_server_script --port $port --delay 2.5
set model_server_spawn_id $spawn_id
expect {
    -re {fake_model_server_ready:([0-9]+)} {
        set port $expect_out(1,string)
    }
    timeout {
        error "timeout waiting for fake model server"
    }
    eof {
        error "fake model server exited before ready"
    }
}

spawn env \
    TIMEM_API_KEY=dummy \
    TIMEM_API_PROTOCOL=openai-compatible \
    TIMEM_BASE_URL=http://127.0.0.1:$port/v1 \
    TIMEM_MODEL=fake-supplement-model \
    $binary --space $memory_dir
expect {
    -re "\033\\\[\\?2004h" {}
    timeout {
        error "timeout waiting for bracketed paste mode enable"
    }
    eof {
        error "unexpected EOF waiting for bracketed paste mode enable"
    }
}
wait_prompt
send "请等待我取消这一轮。\r"
answer_cursor_queries
after 300
send "\003"
set cancel_started [clock milliseconds]
set cancel_output [wait_active_turn_cancelled]
set cancel_elapsed [expr {[clock milliseconds] - $cancel_started}]
if {$cancel_elapsed > 1500} {
    error "active turn Ctrl+C cancellation took ${cancel_elapsed}ms, expected <= 1500ms; output=$cancel_output"
}
wait_prompt
send "Q1：最终答案只输出 NO_SUPPLEMENT。\r"
answer_cursor_queries
after 500
send "Q2：最终答案只输出 SUPPLEMENT_OK。\r"
set supplement_output ""
expect {
    -re "\033\\\[6n" {
        append supplement_output $expect_out(buffer)
        send "\033\[24;1R"
        exp_continue
    }
    -re "SUPPLEMENT_OK" {
        append supplement_output $expect_out(buffer)
        if {[regexp -all -- "SUPPLEMENT_OK" $supplement_output] < 2} {
            exp_continue
        }
    }
    timeout {
        error "timeout waiting for queued second answer"
    }
    eof {
        error "unexpected EOF waiting for queued second answer"
    }
}
set first_answer [string first "NO_SUPPLEMENT" $supplement_output]
set second_question [string first "Q2：最终答案只输出" $supplement_output]
set second_answer [string first "SUPPLEMENT_OK" $supplement_output [expr {$second_question + 1}]]
if {$first_answer < 0} {
    error "first answer was lost or overwritten; output=$supplement_output"
}
if {$second_question < 0} {
    error "queued Q2 was not rendered as a new user turn; output=$supplement_output"
}
if {$second_answer < 0} {
    error "queued Q2 answer missing SUPPLEMENT_OK; output=$supplement_output"
}
if {!($first_answer < $second_question && $second_question < $second_answer)} {
    error "expected Q1 answer, then Q2 user bubble, then Q2 answer; output=$supplement_output"
}
send "/prof\r"
set prof_output ""
set prof_seen 0
set old_timeout $timeout
set timeout 1
set prof_deadline [expr {[clock milliseconds] + 10000}]
while {!$prof_seen && [clock milliseconds] < $prof_deadline} {
    expect {
        -re "\033\\\[6n" {
            append prof_output $expect_out(buffer)
            send "\033\[24;1R"
        }
        -re "思考中|模型调用失败" {
            append prof_output $expect_out(buffer)
            error "shell command after model answer should not start another model turn; output=$prof_output"
        }
        -re ".+" {
            append prof_output $expect_out(buffer)
            if {[string first "Timem runtime profiling" $prof_output] >= 0} {
                set prof_seen 1
            }
        }
        timeout {}
        eof {
            error "unexpected EOF waiting for /prof after model answer"
        }
    }
}
set timeout $old_timeout
if {!$prof_seen} {
    error "timeout waiting for /prof after model answer; output=$prof_output"
}
after 300
send "/exit\r"
expect {
    -re "\033\\\[6n" {
        send "\033\[24;1R"
        exp_continue
    }
    eof {}
    timeout {}
}
set spawn_id $model_server_spawn_id
catch {close}
catch {wait}
puts "real_tty_supplement_smoke: ok"
exit 0
