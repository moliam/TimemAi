# Timem shell environment template.
# Copy this file to any private path, edit it, then source it before running
# timem or cargo run.
#
# Recommended local copy inside this clone:
#   cp env_template env
#   $EDITOR env
#   source /absolute/path/to/env
#
# Keep the copied env file private. Do not commit API keys.

# Wire protocol / request payload format.
# Known values: openai-compatible, openai-responses, anthropic.
# Default: openai-compatible.
# export TIMEM_API_PROTOCOL=openai-compatible
# export TIMEM_RESPONSE_PROTOCOL=xml

# Generic API key. Prefer env/source over command-line flags so secrets do not
# land in shell history.
# export TIMEM_API_KEY=

# Model API base URL. The default follows TIMEM_API_PROTOCOL; set this explicitly
# for any compatible or self-hosted service.
# export TIMEM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model name.
# export TIMEM_MODEL=qwen-plus

# Memory/audit space name.
# export TIMEM_SPACE=.test_mem

# Runtime data root for memory, audit logs, and shell history.
# Default for a new environment: .timem_data
# export TIMEM_DATA_DIR=.timem_data

# Model API request timeout in seconds.
# export TIMEM_TIMEOUT=120

# Maximum response tokens.
# export TIMEM_MAX_LLM_OUTPUT=20K

# Optional OpenAI-compatible reasoning/streaming extensions. Enable only when
# the selected model service documents these fields.
# export TIMEM_ENABLE_THINKING=true
# export TIMEM_REASONING_EFFORT=max
# export TIMEM_STREAM=true

# Maximum LLM input context window. Accepts plain numbers or K suffix, such as 100K.
# export TIMEM_MAX_LLM_INPUT=100K

# Optional runtime capability overlay directory. Directory layout:
#   capabilities/tools/*.yaml
#   capabilities/skills/<skill_id>/skill.yaml
# export TIMEM_CAPABILITIES_DIR=capabilities

# Bash approval policy.
# ask: prompt before bash execution.
# approve: execute requested bash actions directly.
# export TIMEM_BASH_APPROVAL=approve

# Work directory instruction files.
# silent: automatically load AGENTS.md/CLAUDE.md from the current working directory and notify.
# ask: ask before loading.
# off: do not load them.
# export TIMEM_WORK_INSTRUCTIONS=silent

# Vendor-specific fallback keys.
# export DASHSCOPE_API_KEY=
# export OPENAI_API_KEY=
# export ANTHROPIC_API_KEY=
# export ANTHROPIC_AUTH_TOKEN=

# Protocol default URLs:
# openai-compatible: https://dashscope.aliyuncs.com/compatible-mode/v1
# openai-responses: https://api.openai.com/v1
# anthropic: https://api.anthropic.com
