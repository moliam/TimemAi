{
  "name": "timem-web",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --exclude tests/assistant_ui_contract.test.ts",
    "test:legacy-contract": "vitest run tests/assistant_ui_contract.test.ts",
    "test:watch": "vitest",
    "test:ui:stop": "pnpm build && node tests/browser/stop-ui-acceptance.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.14.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "highlight.js": "11.11.1",
    "katex": "0.16.22",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "onlyBuiltDependencies": [
    "esbuild"
  ]
}
